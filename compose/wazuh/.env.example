# Copy to .env and change every value. Compose reads .env from this directory
# automatically; the .env file itself is git-ignored.
#
# Wazuh keeps credentials in three places. ./setup.sh (via prepare.sh) reads the
# values below and:
#   - passes them to the manager and dashboard containers,
#   - bcrypt-hashes the indexer ones into config/wazuh_indexer/internal_users.yml,
#   - writes the API one into config/wazuh_dashboard/wazuh.yml.
# So: change them here, then run ./setup.sh again.

# OpenSearch "admin" superuser — manager and dashboard use it to reach the indexer.
WAZUH_INDEXER_PASSWORD=Please-Change-Me-Before-Deploying-1!

# "kibanaserver" — the account the dashboard backend uses for the indexer.
WAZUH_DASHBOARD_PASSWORD=Please-Change-Me-Before-Deploying-1!

# "wazuh-wui" — the Wazuh REST API user (port 55000).
WAZUH_API_PASSWORD=Please-Change-Me-Before-Deploying-1!
