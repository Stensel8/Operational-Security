# Copy to .env and change every value, then run ./setup.sh again. The .env file
# is git-ignored; prepare.sh feeds these into the containers and the rendered
# config/ files (internal_users.yml, wazuh.yml).

# OpenSearch "admin" superuser — manager and dashboard use it to reach the indexer.
WAZUH_INDEXER_PASSWORD=Please-Change-Me-Before-Deploying-1!

# "kibanaserver" — the account the dashboard backend uses for the indexer.
WAZUH_DASHBOARD_PASSWORD=Please-Change-Me-Before-Deploying-1!

# "wazuh-wui" — the Wazuh REST API user (port 55000).
WAZUH_API_PASSWORD=Please-Change-Me-Before-Deploying-1!
