# Copy to .env and change every value. Compose reads .env from this directory
# automatically; the .env file itself is git-ignored.

# OpenObserve root account. The OpenTelemetry Collector authenticates to
# OpenObserve with these same credentials (HTTP Basic).
OPENOBSERVE_ROOT_USER_EMAIL=admin@operational-security.test
OPENOBSERVE_ROOT_USER_PASSWORD=Please-Change-Me-Before-Deploying-1!
